PORT=3001
NODE_ENV=development

# Comma-separated origins allowed for direct browser requests (optional)
CORS_ORIGINS=http://localhost:3000,https://flintworks.hu

# Path to email-templates (defaults to ../email-templates in dev)
EMAIL_TEMPLATES_DIR=../email-templates

# SMTP (e.g. your provider's SMTP relay)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hello@flintworks.io
SMTP_PASSWORD=

# Addresses
MAIL_FROM="Flintworks" <hello@flintworks.io>
MAIL_FROM_NOTIFICATION="Flintworks" <noreply@flintworks.io>
MAIL_TO_TEAM=team@flintworks.io
